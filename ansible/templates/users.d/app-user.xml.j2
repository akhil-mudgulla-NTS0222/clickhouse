<?xml version="1.0"?>
<clickhouse>
    <users>
        <{{ clickhouse_app_user }}>
            <password>{{ clickhouse_app_password }}</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </{{ clickhouse_app_user }}>
    </users>
</clickhouse>
